# Static analysis of the extension.
# Run from the project root: vendor/bin/phpstan analyse -c packages/cal/phpstan.neon.dist
parameters:
  level: 5
  paths:
    - Classes
    - Configuration
    - ext_localconf.php
  excludePaths:
    # depends on the optional extension "scheduler"
    - Classes/Task/*
  reportUnmatchedIgnoredErrors: false
