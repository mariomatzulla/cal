# Minimal page rendering without EXT:fluid_styled_content
lib.contentElement = COA

tt_content = CASE
tt_content.key.field = CType
tt_content.cal_controller = COA
tt_content.cal_controller.20 = EXTBASEPLUGIN
tt_content.cal_controller.20 {
	extensionName = Cal
	pluginName = Controller
}

page = PAGE
page.10 = CONTENT
page.10 {
	table = tt_content
	select.orderBy = sorting
	select.where = {#colPos}=0
}
