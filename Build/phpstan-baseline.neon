parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: ../Classes/Backend/Form/RenderType/RDateElement.php

		-
			message: '#^Strict comparison using \!\=\= between list\<array\<string, mixed\>\> and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: ../Classes/Controller/ContentController.php

		-
			message: '#^Method MarioMatzulla\\Cal\\Domain\\Model\\Calendar\:\:setModelType\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: ../Classes/Domain/Model/Calendar.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: ../Classes/Domain/Model/Event.php

		-
			message: '#^If condition is always true\.$#'
			identifier: if.alwaysTrue
			count: 2
			path: ../Classes/Domain/Model/Event.php

		-
			message: '#^Instanceof between MarioMatzulla\\Cal\\Domain\\Model\\Category and MarioMatzulla\\Cal\\Domain\\Model\\Category will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: ../Classes/Domain/Model/Event.php

		-
			message: '#^Method MarioMatzulla\\Cal\\Domain\\Model\\Event\:\:setModelType\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: ../Classes/Domain/Model/Event.php

		-
			message: '#^Strict comparison using \!\=\= between DateTime and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: ../Classes/Domain/Model/Event.php

		-
			message: '#^Property MarioMatzulla\\Cal\\Domain\\Model\\EventRecDeviationModel\:\:\$origStartDate is unused\.$#'
			identifier: property.unused
			count: 1
			path: ../Classes/Domain/Model/EventRecDeviationModel.php

		-
			message: '#^Call to function is_object\(\) with MarioMatzulla\\Cal\\Model\\WeekView will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: ../Classes/Model/MonthView.php

		-
			message: '#^Method MarioMatzulla\\Cal\\Model\\RightsManager\:\:isTrue5\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: ../Classes/Model/RightsManager.php

		-
			message: '#^Property MarioMatzulla\\Cal\\Model\\TimeView\:\:\$hour is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: ../Classes/Model/TimeView.php

		-
			message: '#^Property MarioMatzulla\\Cal\\Model\\TimeView\:\:\$minute is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: ../Classes/Model/TimeView.php

		-
			message: '#^Strict comparison using \=\=\= between 1 and 1 will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 1
			path: ../Classes/Model/WeekView.php

		-
			message: '#^Method MarioMatzulla\\Cal\\Service\\Auth\\TYPO3PrincipalBackend\:\:getPrincipalByPath\(\) should return array but returns null\.$#'
			identifier: return.type
			count: 1
			path: ../Classes/Service/Auth/TYPO3PrincipalBackend.php

		-
			message: '#^Property MarioMatzulla\\Cal\\Service\\IcsGenerator\:\:\$configurationManager is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: ../Classes/Service/IcsGenerator.php

		-
			message: '#^Property MarioMatzulla\\Cal\\Service\\IcsGenerator\:\:\$moduleTemplateFactory is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: ../Classes/Service/IcsGenerator.php

		-
			message: '#^Strict comparison using \=\=\= between 1 and 0 will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 6
			path: ../Classes/Utility/CalculateDateTime.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 1
			path: ../Classes/Utility/CalculateDateTime.php

		-
			message: '#^Call to MarioMatzulla\\Cal\\Utility\\RecurrenceValidator\:\:checkUntil\(\) on a separate line has no effect\.$#'
			identifier: staticMethod.resultUnused
			count: 1
			path: ../Classes/Utility/RecurrenceValidator.php

		-
			message: '#^Comparison operation "\>" between int\<1, max\> and 0 is always true\.$#'
			identifier: greater.alwaysTrue
			count: 2
			path: ../Classes/Utility/RecurrenceValidator.php

		-
			message: '#^Loose comparison using \=\= between 1 and 1 will always evaluate to true\.$#'
			identifier: equal.alwaysTrue
			count: 1
			path: ../Classes/ViewHelpers/BaseWeekViewHelper.php

		-
			message: '#^Property MarioMatzulla\\Cal\\ViewHelpers\\BaseWeekViewHelper\:\:\$startOffset \(int\) in isset\(\) is not nullable\.$#'
			identifier: isset.property
			count: 1
			path: ../Classes/ViewHelpers/BaseWeekViewHelper.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: ../Classes/ViewHelpers/BaseWeekViewHelper.php

		-
			message: '#^Strict comparison using \=\=\= between 1 and 1 will always evaluate to true\.$#'
			identifier: identical.alwaysTrue
			count: 2
			path: ../Classes/ViewHelpers/BaseWeekViewHelper.php
